---
export interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description = 'A calm, keyboard-first workspace for organizing ideas.', eyebrow = 'Mapflowy' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <title>{title} · Mapflowy</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/home" aria-label="Mapflowy home">
          <img class="brand-mark" src="/icon.svg" width="80" height="34" alt="" />
          <span>{eyebrow}</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/home">Overview</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a class="nav-cta" href="/">Open organizer</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Mapflowy</span>
        <span class="footer-links"><a href="/privacy">Privacy</a><a href="/terms">Terms</a></span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/site.css';
</style>
