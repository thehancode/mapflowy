import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Privacy (draft)">
  <article class="legal"><p class="eyebrow">Privacy</p><h1>Privacy, in plain language.</h1><p class="draft-note">Draft placeholder — not production legal advice</p>
    <p>This draft explains the intended approach for Voronoi Organizer. It is not a final privacy policy and does not create obligations until reviewed and published by the service owner.</p>
    <h2>What we expect to collect</h2><p>When accounts are connected, we may collect an email address, account details needed to authenticate you, and the organizer content you choose to save. We intend to collect only what is needed to provide and protect the service.</p>
    <h2>How we expect to use it</h2><p>Information would be used to provide your workspace, keep it available across sessions, improve reliability, and respond to support requests. We do not intend to sell personal information.</p>
    <h2>Your choices</h2><p>A final policy will explain how to access, export, correct, or delete account data, and how long information is retained.</p>
    <h2>Questions</h2><p>For now, contact <a class="text-link" href="mailto:hello@example.com">hello@example.com</a>. Replace this address and have this draft reviewed before launch.</p>
  </article>
</SiteLayout>
